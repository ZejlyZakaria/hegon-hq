+// EXPÉRIENCE — persistance du cache sur disque
+//
+// Mesurée le 2026-09-12 sur /perso/watching/movies (grille ≥ 40 affiches, médiane sur 5) :
+// grille à 1 200 ms sans, 874 ms avec — −326 ms (27 %) pour 70 Ko de localStorage. Le plancher
+// est l'hydratation : le cache n'est lu qu'après. Verdict (doctrine R4) : possible, chiffré, NON
+// prioritaire. Retirée du code ; ce patch la remet à l'identique pour remesurer ou reconsidérer.
+//
+// ÉTEINTE par défaut : active seulement si localStorage["hegon_persist_experiment"] === "1".
+// Si un jour elle est promue : la faire en SWR (`refetchOnMount: "always"` sur les clés persistées)
+// et SÉLECTIVE (jamais `journal`/`takes` — de l'intime sur le disque). Ce patch ne fait ni l'un
+// ni l'autre : c'est l'instrument de mesure, pas la version déployable.
+// ─────────────────────────────────────────────────────────────────────────────
+const PERSIST_FLAG = "hegon_persist_experiment";
+const PERSIST_KEY = "hegon_query_cache";
+
+function persistEnabled(): boolean {
+  if (typeof window === "undefined") return false;
+  try {
+    return window.localStorage.getItem(PERSIST_FLAG) === "1";
+  } catch {
+    return false;
+  }
+}
+
+/** Recharge le cache depuis le disque AVANT le premier rendu — sinon les
+ *  composants déclenchent leurs requêtes et la persistance ne sert à rien. */
+function hydrateFromDisk(client: QueryClient) {
+  if (!persistEnabled()) return;
+  try {
+    const raw = window.localStorage.getItem(PERSIST_KEY);
+    if (raw) hydrate(client, JSON.parse(raw));
+  } catch {
+    // Cache illisible (quota, version différente) → on repart à vide, pas de crash.
+  }
+}
+
+/** Écrit le cache sur disque, au repos, sans bloquer l'interaction. */
+function persistToDisk(client: QueryClient) {
+  if (!persistEnabled()) return () => {};
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const write = () => {
+    try {
+      const snapshot = dehydrate(client, {
+        shouldDehydrateQuery: (q) => q.state.status === "success",
+      });
+      window.localStorage.setItem(PERSIST_KEY, JSON.stringify(snapshot));
+    } catch {
+      // Quota dépassé : on abandonne silencieusement, le cache mémoire suffit.
+    }
+  };
+  const unsubscribe = client.getQueryCache().subscribe(() => {
+    clearTimeout(timer);
+    timer = setTimeout(write, 1000);
+  });
+  return () => {
+    clearTimeout(timer);
+    unsubscribe();
+  };
+}
